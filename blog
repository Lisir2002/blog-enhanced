#!/usr/bin/env php
<?php

/**
 * Blog CMS CLI 入口
 *
 * 用法：
 *   php blog install            # 初始化 + 创建管理员
 *   php blog migrate             # 执行 pending 迁移
 *   php blog migrate:status      # 查看迁移状态
 *   php blog migrate:rollback    # 回滚最后一批迁移
 *   php blog seed                # 填充种子数据
 *   php blog serve               # 启动开发服务器
 */

if (php_sapi_name() !== 'cli') {
    exit("CLI only.\n");
}

define('BLOG_ROOT', dirname(__FILE__));

require BLOG_ROOT . '/vendor/autoload.php';

$cli = new \Core\Console\Application();

$cli->add('install', function ($args) {
    include BLOG_ROOT . '/bin/install.php';
    return 0;
}, '初始化数据库并创建管理员');

$cli->add('serve', function ($args) {
    $host = $args[0] ?? 'localhost:8080';
    echo "Server running at http://$host\n";
    echo "Press Ctrl+C to stop.\n";
    passthru("php -S $host -t " . escapeshellarg(public_path()) . " " . escapeshellarg(public_path('index.php')));
    return 0;
}, '启动内置开发服务器');

$cli->add('migrate', function ($args) {
    $app = new \Core\Application();
    $app->bootstrap();
    $migrator = new \Core\Database\Migrator($app->get(\Core\Database\Connection::class));

    $ran = $migrator->run();
    if (empty($ran)) {
        echo "Nothing to migrate — all migrations are up to date.\n";
    } else {
        foreach ($ran as $file) {
            echo "  ✓ Migrated: $file\n";
        }
        echo "\n  " . count($ran) . " migration(s) executed.\n";
    }
    return 0;
}, '执行 pending 迁移');

$cli->add('migrate:status', function ($args) {
    $app = new \Core\Application();
    $app->bootstrap();
    $migrator = new \Core\Database\Migrator($app->get(\Core\Database\Connection::class));

    $status = $migrator->status();
    if (empty($status)) {
        echo "No migrations found.\n";
        return 0;
    }

    echo str_pad('Migration', 50) . str_pad('Status', 12) . "Batch\n";
    echo str_repeat('-', 75) . "\n";
    foreach ($status as $s) {
        $name = substr($s['migration'], 0, 48);
        $ran = $s['ran'] ? '✓ Ran' : '○ Pending';
        $batch = $s['batch'] ?? '-';
        echo str_pad($name, 50) . str_pad($ran, 12) . $batch . "\n";
    }
    return 0;
}, '查看迁移状态');

$cli->add('migrate:rollback', function ($args) {
    $app = new \Core\Application();
    $app->bootstrap();
    $migrator = new \Core\Database\Migrator($app->get(\Core\Database\Connection::class));

    $steps = (int) ($args[0] ?? 0);
    $rolled = $migrator->rollback($steps);
    if (empty($rolled)) {
        echo "Nothing to rollback.\n";
    } else {
        foreach ($rolled as $file) {
            echo "  ↻ Rolled back: $file\n";
        }
        echo "\n  " . count($rolled) . " migration(s) rolled back.\n";
    }
    return 0;
}, '回滚最后一批迁移 (可选指定步数)');

$cli->add('seed', function ($args) {
    include BLOG_ROOT . '/database/seeds/run.php';
    return 0;
}, '填充种子数据');

$cli->add('make:theme', function ($args) {
    $name = $args[0] ?? '';
    if ($name === '') {
        echo "Usage: php blog make:theme <name>\n";
        return 1;
    }

    // PascalCase class name
    $className = str_replace(' ', '', ucwords(str_replace(['-', '_'], ' ', $name)));
    $dir = themes_path($name);

    if (is_dir($dir)) {
        echo "Theme [$name] already exists at $dir\n";
        return 1;
    }

    // Create directory structure
    foreach (['templates', 'partials', 'assets/css', 'assets/js', 'assets/img', 'Widgets'] as $sub) {
        @mkdir("$dir/$sub", 0777, true);
    }

    // theme.json
    file_put_contents("$dir/theme.json", json_encode([
        'name'        => $className,
        'version'     => '1.0.0',
        'description' => "$className 主题",
        'author'      => '',
        'license'     => 'MIT',
        'screenshot'  => 'screenshot.png',
        'requires'    => '>=1.0',
        'parent'      => null,
        'menus'       => ['primary' => '主导航'],
        'sidebars'    => ['sidebar-1' => ['name' => '主侧边栏', 'description' => '']],
        'page_templates' => new \stdClass(),
        'options'     => new \stdClass(),
        'styles'      => ['style' => ['src' => 'assets/css/style.css', 'deps' => []]],
        'scripts'     => ['main' => ['src' => 'assets/js/main.js', 'deps' => [], 'footer' => true]],
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE) . "\n");

    // functions.php
    file_put_contents("$dir/functions.php", '<?php

/**
 * ' . $className . ' 主题入口
 */

use App\Models\Option;

// 注册菜单
register_nav_menu(\'primary\', \'主导航\');

// 注册 Widget 区域
register_sidebar([
    \'id\'            => \'sidebar-1\',
    \'name\'          => \'主侧边栏\',
    \'description\'   => \'文章页右侧边栏\',
]);

// 排队 CSS/JS
add_action(\'wp_enqueue\', function () {
    enqueue_style(\'style\', theme_asset(\'assets/css/style.css\'), [], \'1.0.0\');
    enqueue_script(\'main\', theme_asset(\'assets/js/main.js\'), [], \'1.0.0\', true);
});

// 站点 <head> 输出
add_action(\'wp_head\', function () {
    $siteName = Option::get(\'site_name\', config(\'app.name\'));
    $desc = Option::get(\'site_description\', \'\');
    echo "<meta name=\"description\" content=\"" . e($desc) . "\">\n";
    echo "<meta property=\"og:site_name\" content=\"" . e($siteName) . "\">\n";
});
');

    // Minimal templates
    $header = '<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><?= e($pageTitle ?? \'Blog\') ?></title>
    <?php wp_head() ?>
</head>
<body class="<?= body_class() ?>">
<header class="site-header">
    <div class="container">
        <a href="<?= url(\'/\') ?>"><?= e(Option::get(\'site_name\', \'Blog\')) ?></a>
        <?= wp_nav_menu([\'theme_location\' => \'primary\']) ?>
    </div>
</header>
<div id="main" class="site-content">
';

    $footer = '</div>
<footer class="site-footer">
    <p><?= e(apply_filters(\'footer_text\', \'© \' . date(\'Y\') . \' Blog\')) ?></p>
</footer>
<?php wp_footer() ?>
</body>
</html>
';

    $sidebar = '<aside class="sidebar">
    <?php dynamic_sidebar(\'sidebar-1\') ?>
</aside>
';

    $home = '<?php get_header() ?>
<div class="container">
    <main class="content-area">
        <?php foreach ($posts ?? [] as $r): $post = new \App\Models\Post($r); ?>
            <article class="<?= post_class() ?>">
                <h2><a href="<?= $post->url() ?>"><?= e($post->getAttribute(\'title\')) ?></a></h2>
                <p><?= e($post->excerpt(160)) ?></p>
            </article>
        <?php endforeach ?>
        <?= paginate_links([\'total\' => $totalPages ?? 1, \'current\' => $page ?? 1]) ?>
    </main>
    <?php get_sidebar() ?>
</div>
<?php get_footer()
';

    $single = '<?php get_header() ?>
<div class="container">
    <main class="content-area">
        <article class="<?= post_class() ?>">
            <h1><?= e($post->getAttribute(\'title\')) ?></h1>
            <div class="post-meta">
                <time><?= e($post->getAttribute(\'published_at\')) ?></time>
                <?php if ($author = $post->author()): ?>
                    <span><?= e($author->displayName()) ?></span>
                <?php endif ?>
                <?= reading_time($post) ?>
            </div>
            <div class="post-content"><?= $post->html() ?></div>
        </article>
    </main>
    <?php get_sidebar() ?>
</div>
<?php get_footer()
';

    $pageTpl = '<?php get_header() ?>
<div class="container">
    <main class="content-area">
        <article>
            <h1><?= e($page[\'title\']) ?></h1>
            <div class="post-content"><?= $html ?></div>
        </article>
    </main>
</div>
<?php get_footer()
';

    $notFound = '<?php get_header() ?>
<div class="container">
    <main class="content-area">
        <p>404 — <?= e($message ?? \'页面不存在\') ?></p>
    </main>
</div>
<?php get_footer()
';

    file_put_contents("$dir/partials/header.php", $header);
    file_put_contents("$dir/partials/footer.php", $footer);
    file_put_contents("$dir/partials/sidebar.php", $sidebar);
    file_put_contents("$dir/templates/home.php", $home);
    file_put_contents("$dir/templates/single.php", $single);
    file_put_contents("$dir/templates/page.php", $pageTpl);
    file_put_contents("$dir/templates/404.php", $notFound);

    // CSS
    file_put_contents("$dir/assets/css/style.css", "/* $className theme */\nbody { font-family: sans-serif; margin: 0; }\n.container { max-width: 1200px; margin: 0 auto; padding: 0 16px; }\n");

    // JS
    file_put_contents("$dir/assets/js/main.js", "/* $className theme JS */\n");

    echo "  ✓ Theme [$name] created at $dir\n";
    echo "  ✓ Edit theme.json to configure menus, sidebars, options\n";
    echo "  ✓ Activate: visit admin → Themes\n";
    return 0;
}, '生成主题骨架 (make:theme <name>)');

$cli->add('hooks:list', function ($args) {
    echo "Blog CMS — Hook Reference\n\n";

    $hooks = [
        ['wp_head', 'Action', '<head> 区域输出', 'header.php'],
        ['wp_footer', 'Action', '页脚区域输出', 'footer.php'],
        ['wp_enqueue', 'Action', '排队 CSS/JS', 'functions.php'],
        ['init', 'Action', '系统初始化完成', 'bootstrap'],
        ['theme_loaded', 'Action', '主题加载完成', 'ThemeManager::boot()'],
        ['after_switch_theme', 'Action', '主题激活后', 'ThemeManager::activate()'],
        ['sidebar_bottom', 'Action', '侧边栏底部', 'sidebar.php'],
        ['post_saved', 'Action', '文章保存后', 'PostService::create/update'],
        ['post_loaded', 'Action', '文章加载后', 'Web/PostController::show'],
        ['comment_created', 'Action', '评论创建后', 'CommentController::store'],
        ['widgets_init', 'Action', 'Widget 初始化', 'functions.php'],
        ['the_content', 'Filter', '文章内容 HTML', 'Post::html()'],
        ['the_title', 'Filter', '文章标题', '模板标签'],
        ['the_excerpt', 'Filter', '文章摘要', 'Post::excerpt()'],
        ['comment_text', 'Filter', '评论文本', 'Comment::html()'],
        ['footer_text', 'Filter', '页脚版权文字', 'footer.php'],
        ['body_class', 'Filter', 'body CSS 类', 'body_class()'],
        ['post_class', 'Filter', 'article CSS 类', 'post_class()'],
        ['nav_menu', 'Filter', '导航菜单 HTML', 'wp_nav_menu()'],
        ['the_content_max_excerpt', 'Filter', '摘要最大长度', 'Post::excerpt()'],
    ];

    echo str_pad('Hook', 30) . str_pad('Type', 8) . str_pad('Source', 30) . "Description\n";
    echo str_repeat('-', 100) . "\n";
    foreach ($hooks as $h) {
        echo str_pad($h[0], 30) . str_pad($h[1], 8) . str_pad($h[3], 30) . $h[2] . "\n";
    }
    echo "\n  Total: " . count($hooks) . " hooks\n";
    return 0;
}, '列出所有可用 Hook');

$cli->add('make', function ($args) {
    $make = new \Core\Console\Commands\MakeCommand();
    return $make->handle($args);
}, '代码生成器 (make:resource/model/controller/middleware)');

$cli->add('queue:work', function ($args) {
    $app = new \Core\Application();
    $app->bootstrap();
    $queue = $app->get(\Core\Queue\Queue::class);
    $queueName = $args[0] ?? 'default';
    $maxJobs = (int) ($args[1] ?? 100);
    $processed = $queue->process($queueName, $maxJobs);
    echo "Processed $processed jobs from queue [$queueName]\n";
    return 0;
}, '处理队列任务 (queue:work [queue] [max])');

$cli->add('queue:size', function ($args) {
    $app = new \Core\Application();
    $app->bootstrap();
    $queue = $app->get(\Core\Queue\Queue::class);
    $queueName = $args[0] ?? 'default';
    $size = $queue->size($queueName);
    echo "Queue [$queueName] size: $size\n";
    return 0;
}, '查看队列大小');

exit($cli->run($argv));
