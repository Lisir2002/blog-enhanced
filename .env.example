APP_NAME="Blog CMS"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=

# Database: sqlite or mysql
DB_DRIVER=sqlite
DB_PATH=database.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=blog
DB_USER=root
DB_PASS=

# Session
SESSION_LIFETIME=120
SESSION_DRIVER=file

# Cache: file or null
CACHE_DRIVER=file

# Mail
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Theme
ACTIVE_THEME=default
